// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// ==========================================
// 1. USER & AUTHENTICATION
// ==========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  avatar    String?
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subscriptions          UserSubscription[]
  payments               PaymentTransaction[]
  userAnswers            UserAnswer[]
  examAttempts           ExamAttempt[]
  flashcardProgress      UserFlashcardProgress[]
  gameSessions           GameSession[]
  aiAnalyses             AIAnalysis[]
  pronunciationAttempts  PronunciationAttempt[]
  userProgress           UserProgress[]
  studyStreak            StudyStreak?
  achievements           UserAchievement[]
  dailyChallenges        UserDailyChallenge[]
  leaderboard            Leaderboard?
  vocabularies           UserVocabulary[]
  setting                UserSetting?
  notifications          Notification[]
}

enum Role {
  USER
  ADMIN
}

// ==========================================
// 2. SUBSCRIPTION & PAYMENT
// ==========================================

enum PlanType {
  FREE
  PREMIUM
  PRO
}

model SubscriptionPlan {
  id       String   @id @default(uuid())
  name     String // "Free", "Premium", "Pro"
  planType PlanType @unique
  price    Float // Giá tiền (VND)
  duration Int // Số ngày
  features String[] // Danh sách tính năng

  // Relations
  subscriptions UserSubscription[]
}

model UserSubscription {
  id        String   @id @default(uuid())
  userId    String
  planId    String
  startDate DateTime @default(now())
  endDate   DateTime
  isActive  Boolean  @default(true)

  // Relations
  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])
}

model PaymentTransaction {
  id            String        @id @default(uuid())
  userId        String
  amount        Float
  currency      String        @default("VND")
  status        PaymentStatus @default(PENDING)
  paymentMethod String? // "momo", "vnpay", "stripe"
  transactionId String?       @unique // ID từ cổng thanh toán
  createdAt     DateTime      @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// ==========================================
// 3. COURSE STRUCTURE
// ==========================================

enum CourseType {
  IELTS
  TOEIC
}

enum SkillType {
  LISTENING
  READING
  WRITING
  SPEAKING
  GRAMMAR
  VOCABULARY
}

model Course {
  id          String     @id @default(uuid())
  title       String
  description String?
  courseType   CourseType
  skillType   SkillType
  thumbnail   String?
  level       Int        @default(1) // 1=Beginner, 2=Intermediate, 3=Advanced
  isPremium   Boolean    @default(false)
  order       Int        @default(0) // Thứ tự hiển thị
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  units        Unit[]
  userProgress UserProgress[]
}

model Unit {
  id          String   @id @default(uuid())
  courseId     String
  title       String
  description String?
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  exercises Exercise[]
}

model Lesson {
  id        String   @id @default(uuid())
  unitId    String
  title     String
  content   String? // Nội dung bài học (HTML/Markdown)
  videoUrl  String?
  audioUrl  String?
  order     Int      @default(0)
  duration  Int? // Thời lượng (phút)
  isPremium Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

// ==========================================
// 4. EXERCISE & QUESTION
// ==========================================

enum ExerciseType {
  MULTIPLE_CHOICE
  FILL_IN_BLANK
  MATCHING
  ORDERING
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
  LISTENING_COMPREHENSION
  READING_COMPREHENSION
}

model Exercise {
  id           String       @id @default(uuid())
  unitId       String
  title        String
  description  String?
  exerciseType ExerciseType
  order        Int          @default(0)
  timeLimit    Int? // Giới hạn thời gian (giây)
  isPremium    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  unit      Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  questions Question[]
}

model Question {
  id          String   @id @default(uuid())
  exerciseId  String
  content     String // Nội dung câu hỏi
  explanation String? // Giải thích đáp án
  audioUrl    String?
  imageUrl    String?
  order       Int      @default(0)
  points      Int      @default(1)
  createdAt   DateTime @default(now())

  // Relations
  exercise              Exercise                @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  options               QuestionOption[]
  userAnswers           UserAnswer[]
  dailyChallengeQuestions DailyChallengeQuestion[]
}

model QuestionOption {
  id         String  @id @default(uuid())
  questionId String
  content    String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  // Relations
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model UserAnswer {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  answer     String // Câu trả lời của user
  isCorrect  Boolean
  timeSpent  Int? // Thời gian làm (giây)
  createdAt  DateTime @default(now())

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// ==========================================
// 5. MOCK EXAM
// ==========================================

model Exam {
  id          String     @id @default(uuid())
  title       String
  description String?
  courseType   CourseType
  totalTime   Int // Tổng thời gian (phút)
  totalScore  Float
  isPremium   Boolean    @default(false)
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  sections ExamSection[]
  attempts ExamAttempt[]
}

model ExamSection {
  id        String    @id @default(uuid())
  examId    String
  title     String // "Part 1: Listening", ...
  skillType SkillType
  order     Int       @default(0)
  timeLimit Int? // Giới hạn thời gian section

  // Relations
  exam      Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions ExamQuestion[]
}

model ExamQuestion {
  id          String  @id @default(uuid())
  sectionId   String
  content     String
  explanation String?
  audioUrl    String?
  imageUrl    String?
  order       Int     @default(0)
  points      Float   @default(1)

  // Relations
  section ExamSection        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  options ExamQuestionOption[]
  answers ExamAnswer[]
}

model ExamQuestionOption {
  id             String  @id @default(uuid())
  examQuestionId String
  content        String
  isCorrect      Boolean @default(false)
  order          Int     @default(0)

  // Relations
  examQuestion ExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)
}

model ExamAttempt {
  id         String     @id @default(uuid())
  userId     String
  examId     String
  score      Float?
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  status     ExamStatus @default(IN_PROGRESS)

  // Relations
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers ExamAnswer[]
}

enum ExamStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model ExamAnswer {
  id         String   @id @default(uuid())
  attemptId  String
  questionId String
  answer     String
  isCorrect  Boolean
  timeSpent  Int?
  createdAt  DateTime @default(now())

  // Relations
  attempt  ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// ==========================================
// 6. MINI GAMES
// ==========================================

enum GameType {
  QUIZ
  FLASHCARD
  WORD_SCRAMBLE
  WORD_MATCH
  HANGMAN
  SPEED_QUIZ
}

model FlashcardSet {
  id          String      @id @default(uuid())
  title       String
  description String?
  courseType   CourseType?
  skillType   SkillType?
  isPremium   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  flashcards Flashcard[]
}

model Flashcard {
  id       String  @id @default(uuid())
  setId    String
  front    String // Mặt trước (từ/câu tiếng Anh)
  back     String // Mặt sau (nghĩa/giải thích)
  audioUrl String?
  imageUrl String?
  order    Int     @default(0)

  // Relations
  set      FlashcardSet            @relation(fields: [setId], references: [id], onDelete: Cascade)
  progress UserFlashcardProgress[]
}

model UserFlashcardProgress {
  id             String    @id @default(uuid())
  userId         String
  flashcardId    String
  confidence     Int       @default(0) // 0-5 (Spaced Repetition level)
  nextReview     DateTime  @default(now()) // Lần ôn tiếp theo
  reviewCount    Int       @default(0)
  lastReviewedAt DateTime?

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId])
}

model GameSession {
  id             String   @id @default(uuid())
  userId         String
  gameType       GameType
  score          Int      @default(0)
  totalQuestions Int      @default(0)
  correctAnswers Int      @default(0)
  timeSpent      Int? // Tổng thời gian (giây)
  createdAt      DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 7. AI FEATURES
// ==========================================

enum AIFeatureType {
  ERROR_ANALYSIS
  PRONUNCIATION_CHECK
  WRITING_REVIEW
  CONVERSATION
  STUDY_PLAN
}

model AIAnalysis {
  id          String        @id @default(uuid())
  userId      String
  featureType AIFeatureType
  inputData   String // Dữ liệu đầu vào (JSON)
  result      String // Kết quả AI trả về (JSON)
  score       Float?
  isPremium   Boolean       @default(true)
  createdAt   DateTime      @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PronunciationAttempt {
  id        String   @id @default(uuid())
  userId    String
  word      String
  audioUrl  String // URL file ghi âm
  score     Float? // Điểm phát âm (0-100)
  feedback  String? // Phản hồi từ AI (JSON)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 8. PROGRESS & GAMIFICATION
// ==========================================

model UserProgress {
  id               String   @id @default(uuid())
  userId           String
  courseId          String
  completedUnits   Int      @default(0)
  completedLessons Int      @default(0)
  totalScore       Float    @default(0)
  progressPercent  Float    @default(0)
  lastAccessedAt   DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model StudyStreak {
  id            String    @id @default(uuid())
  userId        String    @unique
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastStudyDate DateTime?
  updatedAt     DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String  @id @default(uuid())
  name        String
  description String
  icon        String?
  condition   String // Điều kiện (JSON logic)
  points      Int     @default(0)

  // Relations
  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  // Relations
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model DailyChallenge {
  id         String      @id @default(uuid())
  date       DateTime    @unique // Ngày thử thách
  title      String
  courseType  CourseType?
  createdAt  DateTime    @default(now())

  // Relations
  questions       DailyChallengeQuestion[]
  userChallenges  UserDailyChallenge[]
}

model DailyChallengeQuestion {
  id          String @id @default(uuid())
  challengeId String
  questionId  String
  order       Int    @default(0)

  // Relations
  challenge DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  question  Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model UserDailyChallenge {
  id          String    @id @default(uuid())
  userId      String
  challengeId String
  score       Float     @default(0)
  completedAt DateTime?

  // Relations
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
}

model Leaderboard {
  id           String   @id @default(uuid())
  userId       String   @unique
  totalScore   Float    @default(0)
  weeklyScore  Float    @default(0)
  monthlyScore Float    @default(0)
  rank         Int?
  updatedAt    DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 9. VOCABULARY NOTEBOOK
// ==========================================

model UserVocabulary {
  id         String   @id @default(uuid())
  userId     String
  word       String
  meaning    String
  example    String?
  note       String?
  audioUrl   String?
  confidence Int      @default(0) // Spaced repetition level
  nextReview DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, word])
}

// ==========================================
// 10. NOTIFICATION & SETTINGS
// ==========================================

model UserSetting {
  id              String  @id @default(uuid())
  userId          String  @unique
  dailyGoal       Int     @default(15) // Mục tiêu (phút/ngày)
  reminderEnabled Boolean @default(true)
  reminderTime    String  @default("20:00")
  language        String  @default("vi")
  darkMode        Boolean @default(false)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String // "reminder", "achievement", "system"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
